#!/usr/bin/env bash

set -euo pipefail

frontend_path="$(dirname "$(realpath "$0")")/../frontend"
css_path="$(dirname "$(realpath "$0")")/../frontend/themes/v1/static/css"
css_build_path="$(dirname "$(realpath "$0")")/build-css"

watchexec --filter "**/*.css" --ignore "app.min.css" --watch "$css_path" --clear --verbose -- \
  "bash $css_build_path" &
$(cd "$frontend_path" && zola serve --drafts) &
wait
